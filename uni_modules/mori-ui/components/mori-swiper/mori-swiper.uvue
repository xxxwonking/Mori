<template>

<view class="mori-swiper" @keydown.left.prevent="move(-1)" @keydown.right.prevent="move(1)">
  <swiper v-if="items.length > 0" :style="'height:' + height + 'px'" :current="current" :autoplay="autoplay && !reducedMotion && items.length > 1" :interval="Math.max(1000, interval)" :duration="reducedMotion ? 0 : 280" :circular="circular && items.length > 1" :indicator-dots="indicatorDots && items.length > 1" :indicator-active-color="moriPalette.primary" @change="change">
    <swiper-item v-for="(item,index) in items" :key="item.value" :aria-hidden="index != current">
      <view :id="id + '-' + index" class="mori-swiper__slide" role="button" :tabindex="index == current ? 0 : -1" :aria-label="item.title == null ? '查看图片' : item.title!" @click="emit('select', item.value)" @keydown.enter.prevent="emit('select', item.value)" @keydown.space.prevent="emit('select', item.value)">
        <mori-image :src="item.src" :alt="item.title == null ? '轮播图片' : item.title!" :height="height + 'px'" />
        <text v-if="item.title != null" class="mori-swiper__title" :style="'background-color:' + moriPalette.surface + ';color:' + moriPalette.text">{{ item.title }}</text>
      </view>
    </swiper-item>
  </swiper>
  <mori-empty v-else title="暂无图片" description="" />
</view>
</template>

<script setup lang="uts">

import { computed, PropType, nextTick } from 'vue'
import { moriPalette } from '../../theme.uts'
import { MoriSwiperItem, moriBound } from '../../content.uts'
import { moriOverlayReducedMotion } from '../../platform/overlay-accessibility.uts'
import { createMoriFieldId } from '../../platform/accessibility.uts'
import { focusMoriSwiper } from '../../platform/swiper.uts'
const props = defineProps({ modelValue: { type: Number, default: 0 }, items: { type: Array as PropType<MoriSwiperItem[]>, default: (): MoriSwiperItem[] => [] }, height: { type: Number, default: 180 }, autoplay: { type: Boolean, default: false }, interval: { type: Number, default: 4000 }, circular: { type: Boolean, default: true }, indicatorDots: { type: Boolean, default: true } })
const emit = defineEmits(['update:modelValue', 'change', 'select'])
const reducedMotion = moriOverlayReducedMotion()
const id = createMoriFieldId()
const current = computed((): number => Math.floor(moriBound(props.modelValue, 0, Math.max(0, props.items.length - 1))))
function change(event: UniSwiperChangeEvent) { const value = event.detail.current; if (value != props.modelValue) { emit('update:modelValue', value); emit('change', value) } }
function move(direction: number) {
  const count = props.items.length
  if (count <= 1) return
  const next = props.circular ? (current.value + direction + count) % count : Math.max(0, Math.min(count - 1, current.value + direction))
  if (next == current.value) return
  emit('update:modelValue', next)
  emit('change', next)
  nextTick(() => focusMoriSwiper(id + '-' + current.value))
}

</script>

<style lang="scss">
.mori-swiper { width: 100%; }.mori-swiper__slide { position: relative; width: 100%; height: 100%; }.mori-swiper__title { position: absolute; left: 12px; right: 12px; bottom: 24px; border-radius: 6px; padding: 8px 10px; font-size: 13px; line-height: 20px; }
/* #ifdef WEB */
.mori-swiper__slide:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
/* #endif */
</style>
