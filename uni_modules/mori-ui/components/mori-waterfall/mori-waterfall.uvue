<template>
<view class="mori-waterfall" :style="'gap:' + gap + 'px'"><view v-for="(column,index) in layout" :key="index" class="mori-waterfall__column" :style="'gap:' + gap + 'px'"><view v-for="item in column" :key="item.id" :style="'height:' + itemHeight(item) + 'px;overflow:hidden;border-radius:8px;background-color:' + moriPalette.ground"><slot :item="item"><mori-image v-if="item.src != null" :src="item.src!" :alt="item.label" height="70%" /><mori-text :text="item.label" /></slot></view></view><mori-empty v-if="items.length == 0" title="暂无内容" description="" /></view>
</template>

<script setup lang="uts">
import { computed, PropType } from 'vue'
import { MoriDataItem, moriWaterfall, moriNumber } from '../../advanced.uts'
import { moriPalette } from '../../theme.uts'
const props = defineProps({ items: { type: Array as PropType<MoriDataItem[]>, default: (): MoriDataItem[] => [] }, columns: { type: Number, default: 2 }, gap: { type: Number, default: 12 } })
const layout = computed((): MoriDataItem[][] => moriWaterfall(props.items, props.columns))
function itemHeight(item: MoriDataItem): number { return moriNumber(item.height ?? 160, 160, 1, 10000) }
</script>

<style lang="scss">
@import '../../styles/action.scss';
.mori-waterfall { display: flex; flex-direction: row; width: 100%; }.mori-waterfall__column { flex: 1; min-width: 0; display: flex; flex-direction: column; }
</style>
