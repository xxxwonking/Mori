<template>
<view v-if="rendered" class="mori-transition" :style="transitionStyle"><slot /></view>
</template>

<script setup lang="uts">
import { ref, computed, watch, nextTick, onBeforeUnmount } from 'vue'
import { moriOverlayReducedMotion } from '../../platform/overlay-accessibility.uts'
const props = defineProps({ show: { type: Boolean, default: false }, name: { type: String, default: 'fade' }, duration: { type: Number, default: 180 } })
const emit = defineEmits(['beforeEnter', 'afterEnter', 'beforeLeave', 'afterLeave'])
const rendered = ref(false)
const visible = ref(false)
const milliseconds = ref(180)
let timer = 0
let frame = 0
let generation = 0
const transitionStyle = computed((): string => 'opacity:' + (visible.value ? '1' : '0') + ';transform:' + (visible.value ? 'translateY(0) scale(1)' : props.name == 'slide-up' ? 'translateY(12px)' : props.name == 'zoom' ? 'scale(0.96)' : 'translateY(0)') + ';transition-duration:' + milliseconds.value + 'ms;')
watch((): boolean => props.show, (value: boolean) => {
  clearTimeout(timer); clearTimeout(frame)
  const ticket = ++generation
  milliseconds.value = moriOverlayReducedMotion() ? 0 : Math.max(0, Math.min(3000, props.duration))
  if (value) {
    rendered.value = true; emit('beforeEnter')
    nextTick(() => { if (ticket != generation) return; frame = setTimeout(() => { if (ticket != generation) return; visible.value = true; timer = setTimeout(() => { if (ticket == generation) emit('afterEnter') }, milliseconds.value) }, milliseconds.value > 0 ? 20 : 0) })
  } else if (rendered.value) { emit('beforeLeave'); visible.value = false; timer = setTimeout(() => { if (ticket != generation) return; rendered.value = false; emit('afterLeave') }, milliseconds.value) }
}, { immediate: true })
onBeforeUnmount(() => { generation++; clearTimeout(timer); clearTimeout(frame) })
</script>

<style lang="scss">
.mori-transition { transition-property: opacity, transform; transition-timing-function: ease-in-out; }
/* #ifdef WEB */
@media (prefers-reduced-motion: reduce) { .mori-transition { transition: none; } }
/* #endif */
</style>
