<template>
<view class="mori-rate" role="radiogroup" :aria-label="label" :aria-disabled="disabled || readonly" @keydown.right.prevent="select(value + 1)" @keydown.left.prevent="select(value - 1)"><button @keydown.enter.prevent="select(index)" @keydown.space.prevent="select(index)" :aria-disabled="disabled" v-for="index in total" :key="index" class="mori-action mori-rate__item" role="radio" :aria-label="index + ' 分'" :aria-checked="index == value" :disabled="disabled" :tabindex="readonly ? -1 : 0" :style="'background-color:' + (index <= value ? moriPalette.soft : 'transparent') + ';opacity:' + (disabled ? '0.4' : '1')" @click="select(index)"><mori-icon name="star" :size="18" /></button></view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { moriPalette } from '../../theme.uts'
import { clampMoriNumber } from '../../numeric.uts'
const props = defineProps({ modelValue: { type: Number, default: 0 }, count: { type: Number, default: 5 }, disabled: { type: Boolean, default: false }, readonly: { type: Boolean, default: false }, allowClear: { type: Boolean, default: false }, label: { type: String, default: '评分' } })
const emit = defineEmits(['update:modelValue', 'change'])
const total = computed((): number => Math.floor(clampMoriNumber(props.count, 1, 10)))
const value = computed((): number => Math.floor(clampMoriNumber(props.modelValue, 0, total.value)))
function select(next: number) { if (props.disabled || props.readonly) return; let result = Math.floor(clampMoriNumber(next, 0, total.value)); if (result == value.value && props.allowClear) result = 0; if (result != props.modelValue) { emit('update:modelValue', result); emit('change', result) } }
</script>

<style lang="scss">
@import '../../styles/action.scss';
.mori-rate { display: flex; flex-direction: row; flex-wrap: wrap; }
.mori-rate__item { width: 36px; padding: 0; margin-right: 3px; transition: background-color 160ms ease; }
/* #ifdef WEB */
@media (prefers-reduced-motion: reduce) { .mori-rate__item { transition: none; } }
/* #endif */
</style>
