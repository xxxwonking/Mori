<template>

<view class="mori-avatar" :style="avatarStyle" role="img" :aria-label="name.length > 0 ? name : '头像'">
  <image v-if="src.length > 0 && !failed" :key="src" class="mori-avatar__image" :src="src" mode="aspectFill" aria-hidden="true" @error="broken" />
  <text v-else class="mori-avatar__text">{{ fallback }}</text>
</view>
</template>

<script setup lang="uts">

import { ref, watch, computed } from 'vue'
import { moriPalette } from '../../theme.uts'
import { moriBound } from '../../content.uts'
const props = defineProps({ src: { type: String, default: '' }, name: { type: String, default: '' }, size: { type: Number, default: 36 }, square: { type: Boolean, default: false } })
const emit = defineEmits(['error'])
const failed = ref(false)
watch((): string => props.src, () => { failed.value = false })
const fallback = computed((): string => props.name.trim().length > 0 ? props.name.trim().substring(0, 1).toUpperCase() : '?')
const avatarStyle = computed((): string => { const size = moriBound(props.size, 20, 200); return 'width:' + size + 'px;height:' + size + 'px;border-radius:' + (props.square ? '8px' : '50%') + ';background-color:' + moriPalette.value.soft + ';color:' + moriPalette.value.primary + ';font-size:' + Math.max(12, Math.round(size * 0.38)) + 'px' })
function broken() { failed.value = true; emit('error', props.src) }

</script>

<style lang="scss">
.mori-avatar { display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }.mori-avatar__image { width: 100%; height: 100%; }.mori-avatar__text { font-weight: 500; }
</style>
