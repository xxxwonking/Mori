<template>
  <button
    class="mori-button"
    :class="['mori-button--' + variant, 'mori-button--' + size, { 'mori-button--block': block, 'mori-button--disabled': disabled, 'mori-button--round': round }]"
    :style="buttonStyle"
    :disabled="disabled || loading"
    :loading="loading"
    role="button"
    :tabindex="disabled || loading ? -1 : 0"
    :aria-disabled="disabled || loading"
    :aria-busy="loading"
    :hover-class="disabled || loading ? 'none' : 'mori-button--pressed'"
    :hover-stay-time="90"
    @click="handleClick"
    @keydown.enter.prevent="handleClick"
    @keydown.space.prevent="handleClick"
  >
    <text class="mori-button__label" :style="labelStyle"><slot>{{ label }}</slot></text>
  </button>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { moriPalette } from '../../theme.uts'
import { getMoriButtonTextColor } from '../../contrast.uts'

const props = defineProps({
  label: { type: String, default: '' },
  variant: { type: String, default: 'solid' },
  size: { type: String, default: 'md' },
  color: { type: String, default: '' },
  softColor: { type: String, default: '' },
  textColor: { type: String, default: '' },
  backgroundColor: { type: String, default: '' },
  borderColor: { type: String, default: '' },
  block: { type: Boolean, default: false },
  round: { type: Boolean, default: false },
  disabled: { type: Boolean, default: false },
  loading: { type: Boolean, default: false }
})
const emit = defineEmits(['click'])
const resolvedColor = computed((): string => props.color.length > 0 ? props.color : moriPalette.value.primary)
const foreground = computed((): string => props.textColor.length > 0 ? props.textColor : props.variant == 'solid' ? getMoriButtonTextColor(props.backgroundColor.length > 0 ? props.backgroundColor : resolvedColor.value) : resolvedColor.value)
const buttonStyle = computed((): string => {
  let background = resolvedColor.value
  let border = resolvedColor.value
  if (props.variant == 'soft') { background = props.softColor.length > 0 ? props.softColor : moriPalette.value.soft; border = background }
  if (props.variant == 'outline') { background = moriPalette.value.surface; border = props.color.length > 0 ? resolvedColor.value : moriPalette.value.input }
  if (props.variant == 'text') { background = 'transparent'; border = 'transparent' }
  if (props.backgroundColor.length > 0) { background = props.backgroundColor; if (props.variant == 'solid' || props.variant == 'soft') border = background }
  if (props.borderColor.length > 0) border = props.borderColor
  let webStyle = ''
  // #ifdef WEB
  webStyle = '--mori-button-hover:' + (props.backgroundColor.length > 0 ? background : moriPalette.value.accent) + ';--mori-button-ring:' + (props.variant == 'solid' || props.backgroundColor.length > 0 ? getMoriButtonTextColor(background) : moriPalette.value.ring) + ';'
  // #endif
  return 'background-color:' + background + ';border-color:' + border + ';color:' + foreground.value + ';' + webStyle
})
const labelStyle = computed((): string => 'color:' + foreground.value + ';font-size:' + (props.size == 'sm' ? '12px' : props.size == 'lg' ? '14px' : '13px') + ';')
function handleClick() {
  if (!props.disabled && !props.loading) emit('click')
}
</script>

<style lang="scss">
@import '../../styles/tokens.scss';
.mori-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: $mori-control-height;
  padding: 0 14px;
  margin: 0;
  border: 1px solid transparent;
  border-radius: $mori-radius;
  font-size: $mori-font-size;
  line-height: 34px;
}
.mori-button__label { font-weight: 500; line-height: 20px; }
.mori-button--sm { height: 28px; padding: 0 10px; border-radius: 6px; line-height: 26px; }
.mori-button--lg { height: 40px; padding: 0 18px; line-height: 38px; }
.mori-button--block { width: 100%; }
.mori-button--round { border-radius: 28px; }
.mori-button--disabled { opacity: 0.5; }
.mori-button--pressed { opacity: 0.9; }
/* #ifdef WEB */
.mori-button { box-sizing: border-box; cursor: pointer; font-family: inherit; transition: background-color 160ms ease, border-color 160ms ease, opacity 160ms ease; }
.mori-button--solid, .mori-button--outline { box-shadow: $mori-shadow-xs; }
.mori-button:focus-visible { outline: 2px solid var(--mori-button-ring); outline-offset: -3px; }
.mori-button:not([disabled]):hover { opacity: 0.9; }
.mori-button--outline:not([disabled]):hover, .mori-button--text:not([disabled]):hover { background-color: var(--mori-button-hover) !important; opacity: 1; }
.mori-button[disabled] { cursor: not-allowed; }
@media (prefers-reduced-motion: reduce) { .mori-button { transition: none; } }
/* #endif */
/* #ifdef WEB || MP-WEIXIN */
.mori-button::after { border: none; }
/* #endif */
</style>
