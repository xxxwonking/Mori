import { MoriDescriptionItem } from '../../advanced.uts'
import { moriPalette } from '../../theme.uts'
defineProps({ title: { type: String, default: '' }, items: { type: Array as PropType<MoriDescriptionItem[]>, default: (): MoriDescriptionItem[] => [] }, labelWidth: { type: Number, default: 88 } })
</script>

