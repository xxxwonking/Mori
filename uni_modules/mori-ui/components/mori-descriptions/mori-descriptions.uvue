<template>
<view class="mori-descriptions" :aria-label="title"><mori-text v-if="title.length > 0" :text="title" weight="semibold" /><view v-for="(item,index) in items" :key="index" class="mori-descriptions__row" :style="'border-color:' + moriPalette.border"><text class="mori-descriptions__label" :style="'width:' + labelWidth + 'px;color:' + moriPalette.muted">{{ item.label }}</text><view class="mori-descriptions__value" :style="'color:' + moriPalette.text"><slot :item="item" :index="index"><text>{{ item.value.length > 0 ? item.value : '—' }}</text></slot></view></view></view>
</template>

<script setup lang="uts">
