<template>

<view class="mori-password-input"><button class="mori-action mori-password-input__control" role="button" :tabindex="disabled ? -1 : 0" :disabled="disabled" :aria-disabled="disabled" :aria-label="label + '，已输入 ' + Math.min(value.length, cells) + ' 位，共 ' + cells + ' 位'" :style="'color:' + moriPalette.text" @click="focus" @keydown.enter.prevent="focus" @keydown.space.prevent="focus"><view v-for="index in cells" :key="index" class="mori-password-input__cell" :style="'background-color:' + moriPalette.surface + ';border-color:' + (error.length > 0 ? moriPalette.danger : focused && index == Math.min(value.length + 1, cells) ? moriPalette.primary : moriPalette.border)"><view v-if="mask && value.length >= index" class="mori-password-input__dot" :style="'background-color:' + moriPalette.text" /><text v-else>{{ value.substring(index - 1, index) }}</text></view></button><text v-if="error.length > 0 || info.length > 0" class="mori-password-input__message" :style="'color:' + (error.length > 0 ? moriPalette.danger : moriPalette.muted)">{{ error.length > 0 ? error : info }}</text></view>
</template>

<script setup lang="uts">

import { computed } from 'vue'
import { moriPalette } from '../../theme.uts'
import { moriBound } from '../../content.uts'
const props = defineProps({ value: { type: String, default: '' }, length: { type: Number, default: 6 }, mask: { type: Boolean, default: true }, focused: { type: Boolean, default: false }, disabled: { type: Boolean, default: false }, label: { type: String, default: '密码输入' }, info: { type: String, default: '' }, error: { type: String, default: '' } })
const emit = defineEmits(['focus'])
const cells = computed((): number => Math.floor(moriBound(props.length, 1, 12)))
function focus() { if (!props.disabled) emit('focus') }

</script>

<style lang="scss">
@import '../../styles/action.scss';
.mori-password-input__control { width: 100%; padding: 0; gap: 6px; }.mori-password-input__cell { flex: 1; min-width: 0; height: 40px; border: 1px solid; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 18px; box-sizing: border-box; }.mori-password-input__dot { width: 6px; height: 6px; border-radius: 50%; }.mori-password-input__message { display: block; margin-top: 6px; font-size: 11px; line-height: 18px; }
</style>
