<template>

<view class="mori-load-more" :style="'color:' + moriPalette.muted" role="status"><mori-loading v-if="status == 'loading'" :text="loadingText" /><text v-else-if="status == 'finished'">{{ finishedText }}</text><button v-else class="mori-action" role="button" tabindex="0" :style="'color:' + (status == 'error' ? moriPalette.danger : moriPalette.primary)" @click="emit('load')" @keydown.enter.prevent="emit('load')" @keydown.space.prevent="emit('load')">{{ status == 'error' ? errorText : moreText }}</button></view>
</template>

<script setup lang="uts">

import { moriPalette } from '../../theme.uts'
defineProps({ status: { type: String, default: 'more' }, loadingText: { type: String, default: '正在加载' }, finishedText: { type: String, default: '已显示全部内容' }, errorText: { type: String, default: '加载失败，点击重试' }, moreText: { type: String, default: '加载更多' } })
const emit = defineEmits(['load'])

</script>

<style lang="scss">
@import '../../styles/action.scss';
.mori-load-more { display: flex; flex-direction: row; align-items: center; justify-content: center; min-height: 48px; padding: 8px; font-size: 12px; line-height: 20px; }
</style>
