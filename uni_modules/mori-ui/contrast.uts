/** Solid button foreground for opaque hex/rgb colors; use textColor for other CSS formats. */
export function getMoriButtonTextColor(background: string): string {
  const color = background.trim().toLowerCase()
  let channels: number[] = []
  if (/^#[0-9a-f]{3}$/.test(color)) {
    channels = [parseInt(color[1] + color[1], 16), parseInt(color[2] + color[2], 16), parseInt(color[3] + color[3], 16)]
  } else if (/^#[0-9a-f]{6}$/.test(color)) {
    channels = [parseInt(color.substring(1, 3), 16), parseInt(color.substring(3, 5), 16), parseInt(color.substring(5, 7), 16)]
  } else if (/^rgb\(\s*\d+\s*,\s*\d+\s*,\s*\d+\s*\)$/.test(color)) {
    const parts = color.substring(4, color.length - 1).split(',')
    channels = [parseInt(parts[0]), parseInt(parts[1]), parseInt(parts[2])]
  }
  if (channels.length != 3 || channels.some((value): boolean => value < 0 || value > 255)) return '#ffffff'
  const linear = channels.map((value): number => {
    const normalized = value / 255
    return normalized <= 0.04045 ? normalized / 12.92 : Math.pow((normalized + 0.055) / 1.055, 2.4)
  })
  const luminance = linear[0] * 0.2126 + linear[1] * 0.7152 + linear[2] * 0.0722
  const whiteContrast = 1.05 / (luminance + 0.05)
  // Use true black/white so every opaque sRGB background has a choice at >=4.5:1.
  const blackContrast = (luminance + 0.05) / 0.05
  return whiteContrast >= blackContrast ? '#ffffff' : '#000000'
}
