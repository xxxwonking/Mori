import { MoriPickedFile, MoriUploadFile, MoriUploadRequest } from '../upload.uts'

/** Platform adapter. Follow-up IDs are defined in docs/platform-adaptation.md. */
export function chooseMoriImages(count: number, sourceType: string[], success: (files: MoriPickedFile[]) => void, fail: (message: string, cancelled: boolean) => void) {
  // MORI-UP-IOS-01: limited-library, denied permission and camera permission need device evidence.
  // MORI-UP-IOS-02: preserve the returned temp path verbatim; do not strip file:// or decode it.
  // MORI-UP-IOS-03: no silent HEIC conversion; chooseFiles allows a business/native converter.
  uni.chooseImage({ count: Math.max(1, Math.min(9, count)), sourceType, sizeType: ['original'],
    success: (result) => {
      const files: MoriPickedFile[] = []
      result.tempFiles.forEach((file) => { files.push({ path: file.path, size: file.size, name: file.name ?? file.path.substring(file.path.lastIndexOf('/') + 1), type: file.type ?? '' }) })
      success(files)
    },
    fail: (error) => { fail(error.errMsg, error.errCode == 1101001 || error.errMsg.toLowerCase().includes('cancel')) }
  })
}

/** Returns an abort callback; transport success means HTTP 2xx, business success belongs to resolveUrl. */
export function startMoriUpload(file: MoriUploadFile, options: MoriUploadRequest, progress: (value: number) => void, success: (response: string) => void, fail: (message: string) => void): () => void {
  let stopped = false
  // MORI-UP-IOS-04: foreground upload only; suspension/resume/background sessions are not implemented.
  const task = uni.uploadFile({ url: options.url, filePath: file.url, name: options.name, header: options.header, formData: options.formData, timeout: options.timeout,
    success: (result) => { if (stopped) return; if (result.statusCode >= 200 && result.statusCode < 300) success(result.data); else fail('上传失败（HTTP ' + result.statusCode + '）') },
    fail: (error) => { if (!stopped) fail(error.errMsg) }
  })
  task.onProgressUpdate((result) => { if (!stopped) progress(result.progress) })
  return () => { stopped = true; task.abort() }
}

export function previewMoriImages(current: string, urls: string[]) { uni.previewImage({ current, urls }) }
