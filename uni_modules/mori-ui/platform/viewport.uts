import { ref, onMounted, onBeforeUnmount } from 'vue'

/** Window coordinates, not screen coordinates. Browser APIs stay in this adapter. */
export type MoriViewport = { width: number; height: number; top: number; left: number; safeTop: number; safeBottom: number }
const viewport = ref<MoriViewport>({ width: 375, height: 667, top: 0, left: 0, safeTop: 0, safeBottom: 0 })
let subscribers = 0

function updateViewport() {
  try {
    const info = uni.getWindowInfo()
    let width = info.windowWidth, height = info.windowHeight, top = 0, left = 0
    const insets = info.safeAreaInsets
    let safeTop = insets == null || !Number.isFinite(insets.top) ? 0 : Math.max(0, insets.top)
    let safeBottom = insets == null || !Number.isFinite(insets.bottom) ? 0 : Math.max(0, insets.bottom)
    // #ifdef WEB
    width = window.innerWidth; height = window.innerHeight
    // Follow a keyboard/browser toolbar resize, but leave pinch zoom to the browser.
    const visual = window.visualViewport
    if (visual != null && Math.abs(visual.scale - 1) < 0.01) {
      width = visual.width; height = visual.height; top = visual.offsetTop; left = visual.offsetLeft
    }
    // Web safe areas are resolved by CSS env() on mori-safe-area.
    safeTop = 0; safeBottom = 0
    // #endif
    if (Number.isFinite(width) && Number.isFinite(height) && width > 0 && height > 0) viewport.value = { width, height, top, left, safeTop, safeBottom }
  } catch (_) { /* Keep the last usable window during host transitions. */ }
}

function listen(start: boolean) {
  // #ifdef WEB
  if (start) {
    window.addEventListener('resize', updateViewport)
    window.visualViewport?.addEventListener('resize', updateViewport)
    window.visualViewport?.addEventListener('scroll', updateViewport)
  } else {
    window.removeEventListener('resize', updateViewport)
    window.visualViewport?.removeEventListener('resize', updateViewport)
    window.visualViewport?.removeEventListener('scroll', updateViewport)
  }
  // #endif
  // #ifndef WEB
  if (start) uni.onWindowResize(updateViewport)
  else uni.offWindowResize(updateViewport)
  // #endif
}

/** A single host subscription is shared and released after the last consumer. */
export function useMoriViewport() {
  onMounted(() => { if (subscribers++ == 0) listen(true); updateViewport() })
  onBeforeUnmount(() => { subscribers--; if (subscribers == 0) listen(false) })
  return viewport
}
