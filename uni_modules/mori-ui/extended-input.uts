export type MoriCountDownInstance = { start: () => void; pause: () => void; reset: () => void }
export type MoriCountToInstance = { start: () => void; reset: () => void }
export type MoriCascaderInstance = { confirm: () => void; cancel: () => void }
export type MoriListInstance = { check: () => void }
export type MoriRefreshInstance = { refresh: () => void }
export type MoriSwipeCellInstance = { open: (side?: string) => void; close: () => void }
export type MoriTreeNode = { value: string; label: string; disabled?: boolean; leaf?: boolean; children?: MoriTreeNode[] }
export type MoriLazyChildren = { value: string; children: MoriTreeNode[] }
export function moriLoadedTree(options: MoriTreeNode[], loaded: MoriLazyChildren[]): MoriTreeNode[] {
  return options.map((node: MoriTreeNode): MoriTreeNode => {
    const found = loaded.find((item: MoriLazyChildren): boolean => item.value == node.value)
    const children = found != null ? found.children : node.children
    const result: MoriTreeNode = { value: node.value, label: node.label, disabled: node.disabled, leaf: found != null && found.children.length == 0 ? true : node.leaf }
    if (children != null) result.children = moriLoadedTree(children, loaded)
    return result
  })
}
export function moriTreeLeaves(options: MoriTreeNode[], value: string, ancestorDisabled: boolean = false): string[] {
  for (let i = 0; i < options.length; i++) {
    const node = options[i]
    const disabled = ancestorDisabled || node.disabled == true
    if (node.value == value) {
      if (disabled) return []
      if (node.children == null || node.children!.length == 0) return [node.value]
      let values: string[] = []
      node.children!.forEach((child: MoriTreeNode) => { values = values.concat(moriTreeLeaves([child], child.value, disabled)) })
      return values
    }
    if (node.children != null) { const found = moriTreeLeaves(node.children!, value, disabled); if (found.length > 0) return found }
  }
  return []
}
export type MoriTreeRow = { value: string; label: string; disabled: boolean; depth: number; branch: boolean }
export type MoriIndexSection = { index: string; title: string; items: string[] }
export function moriTreePath(options: MoriTreeNode[], path: string[]): MoriTreeNode[] {
  const result: MoriTreeNode[] = []
  let level = options
  for (let index = 0; index < path.length; index++) {
    const item = level.find((node: MoriTreeNode): boolean => node.value == path[index] && node.disabled != true)
    if (item == null) break
    result.push(item)
    level = item.children == null ? [] : item.children!
  }
  return result
}
export function moriTreeRows(options: MoriTreeNode[], expanded: string[], depth: number = 0, ancestorDisabled: boolean = false): MoriTreeRow[] {
  let result: MoriTreeRow[] = []
  options.forEach((node: MoriTreeNode) => {
    const branch = node.children != null && node.children!.length > 0
    const disabled = ancestorDisabled || node.disabled == true
    result.push({ value: node.value, label: node.label, disabled, depth, branch })
    if (branch && expanded.includes(node.value)) result = result.concat(moriTreeRows(node.children!, expanded, depth + 1, disabled))
  })
  return result
}
export function moriKeyboardValue(value: string, key: string, maxLength: number, extraKey: string): string {
  if (key == 'delete') return value.substring(0, Math.max(0, value.length - 1))
  if (key == 'clear') return ''
  if (!/^[0-9]$/.test(key) && !(key.length == 1 && key == extraKey && (key == '.' || key == 'X'))) return value
  const limit = Number.isFinite(maxLength) ? Math.max(1, Math.floor(maxLength)) : 6
  if (value.length >= limit || (key == '.' && value.includes('.'))) return value
  return value + key
}
