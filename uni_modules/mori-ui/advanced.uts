export type MoriDataItem = { id: string; label: string; height?: number; src?: string }
export type MoriTableColumn = { key: string; label: string; width?: number; sortable?: boolean }
export type MoriDescriptionItem = { label: string; value: string }
export type MoriRichBlock = { type: string; text?: string; src?: string }
export type MoriSwipeAction = { value: string; label: string; disabled?: boolean; danger?: boolean }
export type MoriPoint = { x: number; y: number }
export function moriNumber(value: number, fallback: number, min: number, max: number): number { return Number.isFinite(value) ? Math.max(min, Math.min(max, value)) : fallback }
export function moriVirtualRange(length: number, top: number, row: number, height: number, overscan: number): number[] {
  const size = moriNumber(row, 44, 1, 10000)
  const buffer = Math.floor(moriNumber(overscan, 3, 0, 100))
  const offset = moriNumber(top, 0, 0, Math.max(0, length * size))
  const first = Math.max(0, Math.min(Math.max(0, length - 1), Math.floor(offset / size)))
  return [Math.max(0, first - buffer), Math.min(length, Math.ceil((offset + height) / size) + buffer)]
}
export function moriMoveItem(items: MoriDataItem[], from: number, to: number): MoriDataItem[] {
  const result = items.slice()
  if (from < 0 || from >= result.length || to < 0 || to >= result.length || from == to) return result
  const moved = result.splice(from, 1)[0]; result.splice(to, 0, moved); return result
}
export function moriWaterfall(items: MoriDataItem[], columns: number): MoriDataItem[][] {
  const count = Math.floor(moriNumber(columns, 2, 1, 6))
  const result: MoriDataItem[][] = []; const heights: number[] = []
  for (let i = 0; i < count; i++) { result.push([]); heights.push(0) }
  items.forEach((item: MoriDataItem) => { let target = 0; for (let i = 1; i < count; i++) if (heights[i] < heights[target]) target = i; result[target].push(item); heights[target] += moriNumber(item.height ?? 160, 160, 1, 10000) })
  return result
}
export function moriCropRect(width: number, height: number, zoom: number, x: number, y: number, ratio: number): number[] {
  const w = Math.max(1, width), h = Math.max(1, height), r = moriNumber(ratio, 1, 0.1, 10), z = moriNumber(zoom, 1, 1, 8)
  const cropW = Math.min(w, h * r) / z, cropH = cropW / r
  return [(w - cropW) * moriNumber(x, 50, 0, 100) / 100, (h - cropH) * moriNumber(y, 50, 0, 100) / 100, cropW, cropH]
}

export type MoriVirtualListInstance = { scrollToIndex: (index: number) => Promise<void> }
export type MoriSignatureInstance = { clear: () => void; undo: () => void; exportImage: () => string }
export type MoriImageCropperInstance = { reset: () => void; exportImage: () => string }
export type MoriVideoInstance = { play: () => void; pause: () => void; seek: (seconds: number) => void }
