export type MoriGridItem = { value: string; label: string; icon?: string; description?: string; disabled?: boolean }
export type MoriAvatarItem = { value: string; name: string; src?: string }
export type MoriStepItem = { title: string; description?: string; time?: string; error?: boolean }
export type MoriSwiperItem = { value: string; src: string; title?: string }
export type MoriHighlightPart = { text: string; highlighted: boolean }
export function moriFinite(value: number, fallback: number): number { return Number.isFinite(value) ? value : fallback }
export function moriBound(value: number, min: number, max: number): number { return Math.min(max, Math.max(min, moriFinite(value, min))) }
export function moriHighlight(text: string, query: string, caseSensitive: boolean): MoriHighlightPart[] {
  if (query.length == 0) return [{ text, highlighted: false }]
  const haystack = caseSensitive ? text : text.toLowerCase()
  const needle = caseSensitive ? query : query.toLowerCase()
  const result: MoriHighlightPart[] = []
  let cursor = 0
  let found = haystack.indexOf(needle)
  while (found >= 0) {
    if (found > cursor) result.push({ text: text.substring(cursor, found), highlighted: false })
    result.push({ text: text.substring(found, found + query.length), highlighted: true })
    cursor = found + query.length
    found = haystack.indexOf(needle, cursor)
  }
  if (cursor < text.length) result.push({ text: text.substring(cursor), highlighted: false })
  return result
}
export function moriCountdownText(milliseconds: number): string {
  const seconds = Math.ceil(Math.max(0, moriFinite(milliseconds, 0)) / 1000)
  const hours = Math.floor(seconds / 3600)
  const minutes = Math.floor(seconds % 3600 / 60)
  return hours.toString().padStart(2, '0') + ':' + minutes.toString().padStart(2, '0') + ':' + (seconds % 60).toString().padStart(2, '0')
}
