export type MoriCalendarMark = { date: string; text: string }
export type MoriCalendarDay = { date: string; day: number; disabled: boolean; selected: boolean; inRange: boolean; text: string }
export type MoriCalendarInstance = { scrollToDate: (date: string) => void; confirm: () => void }
export function moriPad(value: number): string { return value < 10 ? '0' + value : '' + value }
export function moriToday(): string { const date = new Date(); return date.getFullYear() + '-' + moriPad(date.getMonth() + 1) + '-' + moriPad(date.getDate()) }
/** Strict calendar dates, UTC arithmetic only; no locale parsing or DST day division. */
export function parseMoriDate(value: string): Date | null {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return null
  const year = parseInt(value.substring(0, 4)); const month = parseInt(value.substring(5, 7)); const day = parseInt(value.substring(8, 10))
  if (year < 1000 || year > 9999) return null
  const date = new Date(Date.UTC(year, month - 1, day))
  return date.getUTCFullYear() == year && date.getUTCMonth() == month - 1 && date.getUTCDate() == day ? date : null
}
export function formatMoriDate(date: Date): string { return date.getUTCFullYear() + '-' + moriPad(date.getUTCMonth() + 1) + '-' + moriPad(date.getUTCDate()) }
export function moriDateAllowed(value: string, min: string, max: string, disabled: string[]): boolean {
  return parseMoriDate(value) != null && (parseMoriDate(min) == null || value >= min) && (parseMoriDate(max) == null || value <= max) && !disabled.includes(value)
}
export function selectMoriDate(current: string[], value: string, type: string, min: string, max: string, disabled: string[], maxRange: number): string[] | null {
  if (!moriDateAllowed(value, min, max, disabled)) return null
  if (type == 'multiple') return current.includes(value) ? current.filter((item: string): boolean => item != value) : current.concat([value]).sort()
  if (type != 'range') return [value]
  if (current.length != 1 || value < current[0]) return [value]
  const start = parseMoriDate(current[0]); const end = parseMoriDate(value)
  if (start == null || end == null || !moriDateAllowed(current[0], min, max, disabled)) return [value]
  if (maxRange > 0 && (end.getTime() - start.getTime()) / 86400000 + 1 > maxRange) return null
  if (disabled.some((item: string): boolean => item >= current[0] && item <= value)) return null
  return [current[0], value]
}
export function validMoriCalendarValue(values: string[], type: string, min: string, max: string, disabled: string[], maxRange: number): boolean {
  if (values.length == 0 || values.some((item: string): boolean => !moriDateAllowed(item, min, max, disabled))) return false
  if (type == 'range') return values.length == 2 && values[0] <= values[1] && selectMoriDate([values[0]], values[1], 'range', min, max, disabled, maxRange) != null
  return type == 'multiple' || values.length == 1
}
