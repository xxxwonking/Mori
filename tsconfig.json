{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@dcloudio/uni-app-x"],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["**/*.ts", "**/*.d.ts", "**/*.uts", "**/*.uvue"],
  "exclude": ["node_modules", "unpackage"]
}
