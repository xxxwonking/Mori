<template>
  <!-- #ifdef APP -->
  <scroll-view scroll-y class="feedback-scroll">
  <!-- #endif -->
  <view class="feedback-page" :class="{ 'feedback-page--dark': moriIsDark }" :style="'background-color:' + moriPalette.ground + ';color:' + moriPalette.text">
    <view class="feedback-shell">
      <view class="feedback-header"><button class="feedback-back" :style="'color:' + moriPalette.primary" @click="back">返回组件实验室</button><view class="feedback-themes"><mori-button label="自动" variant="text" size="sm" @click="appearance('auto')" /><mori-button label="浅色" variant="text" size="sm" @click="appearance('light')" /><mori-button label="深色" variant="text" size="sm" @click="appearance('dark')" /></view></view>
      <view class="feedback-intro"><text class="feedback-title">反馈组件</text><text class="feedback-subtitle" :style="'color:' + moriPalette.muted">轻提示传递结果，弹出层承载内容，对话框确认决定。</text></view>
      <view class="feedback-content" :style="'background-color:' + moriPalette.surface + ';border-color:' + moriPalette.border">
        <view class="feedback-section"><view class="feedback-copy"><text class="feedback-section-title">Toast 轻提示</text><text class="feedback-description" :style="'color:' + moriPalette.muted">连续点击会替换当前提示。普通提示 2 秒后消失，加载提示持续到手动关闭。</text></view><view class="feedback-actions"><mori-button label="文字提示" variant="soft" @click="notify('text')" /><mori-button label="成功提示" variant="soft" @click="notify('success')" /><mori-button label="失败提示" variant="soft" @click="notify('error')" /><mori-button label="加载提示" variant="soft" @click="notify('loading')" /><mori-button label="顶部提示" variant="outline" @click="notifyAt('top')" /><mori-button label="底部提示" variant="outline" @click="notifyAt('bottom')" /><mori-button label="关闭提示" variant="text" @click="closeToast" /></view></view>
        <view class="feedback-divider" :style="'background-color:' + moriPalette.border"></view>
        <view class="feedback-section"><view class="feedback-copy"><text class="feedback-section-title">Popup 弹出层</text><text class="feedback-description" :style="'color:' + moriPalette.muted">从屏幕边缘展开，或居中展示。点击遮罩、关闭按钮或按 Escape 返回原页面。</text></view><view class="feedback-actions"><mori-button label="底部弹出" @click="openPopup('bottom')" /><mori-button label="居中弹出" variant="outline" @click="openPopup('center')" /><mori-button label="侧边弹出" variant="outline" @click="openPopup('right')" /><mori-button label="顶部弹出" variant="outline" @click="openPopup('top')" /><mori-button label="左侧弹出" variant="outline" @click="openPopup('left')" /><mori-button label="无遮罩弹出" variant="text" @click="openNonModal" /></view><text class="feedback-note" :style="'color:' + moriPalette.muted">底部弹层中的“查看说明”可体验多层弹窗。关闭上层后，下层仍可操作。</text></view>
        <view class="feedback-divider" :style="'background-color:' + moriPalette.border"></view>
        <view class="feedback-section"><view class="feedback-copy"><text class="feedback-section-title">Dialog 对话框</text><text class="feedback-description" :style="'color:' + moriPalette.muted">重要操作先确认。示例会模拟一次保存，等待期间保留弹框并阻止重复提交。</text></view><view class="feedback-actions"><mori-button label="确认对话框" @click="dialogVisible = true" /><mori-button label="消息对话框" variant="outline" @click="noticeVisible = true" /></view><text class="feedback-result" role="status" aria-live="polite" :style="'color:' + moriPalette.muted">{{ result }}</text></view>
      </view>
      <text class="feedback-footer" :style="'color:' + moriPalette.muted">所有操作均为本地演示，不会提交资料或修改系统设置。</text>
    </view>
  </view>
  <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
  <mori-popup v-model="popupVisible" :position="popupPosition" :title="popupTitle" :overlay="popupOverlay">
    <view class="popup-example">
      <text class="popup-example-copy" :style="'color:' + moriPalette.muted">选择你希望收到通知的方式。</text>
      <mori-radio-group v-model="reminder" :options="reminders" label="通知方式" />
      <view class="popup-example-actions"><mori-button label="完成" @click="finishPopup" /><mori-button label="查看说明" variant="text" @click="nestedVisible = true" /></view>
    </view>
  </mori-popup>
  <mori-popup v-model="nestedVisible" position="center" title="提醒说明">
    <view class="popup-example"><text class="popup-example-copy" :style="'color:' + moriPalette.muted">这是第二层弹窗。关闭它后，你的选择会保留，焦点回到下层的入口。</text><mori-button label="我知道了" block @click="nestedVisible = false" /></view>
  </mori-popup>
  <mori-dialog v-model="dialogVisible" title="保存本次修改？" message="确认后会模拟保存当前偏好，约需 1 秒。你可以在保存开始前取消。" confirm-text="确认保存" :confirm-loading="saving" @confirm="confirmSave" @cancel="cancelSave" />
  <mori-dialog v-model="noticeVisible" title="版本说明" message="Mori 的反馈组件已支持浅深主题与统一交互。" :show-cancel-button="false" confirm-text="知道了" @confirm="noticeVisible = false" />
  <mori-toast ref="toast" />
</template>

<script setup lang="uts">
import { ref, computed, onUnmounted } from 'vue'
import { moriIsDark, moriPalette, setMoriConfig } from '../../uni_modules/mori-ui/theme.uts'
import { MoriToastInstance } from '../../uni_modules/mori-ui/feedback.uts'
import { MoriChoiceOption } from '../../uni_modules/mori-ui/selection.uts'
const toast = ref<MoriToastInstance | null>(null)
const popupVisible = ref(false)
const nestedVisible = ref(false)
const popupPosition = ref('bottom')
const popupOverlay = ref(true)
const popupTitle = computed((): string => popupPosition.value == 'bottom' ? '选择提醒方式' : popupPosition.value == 'center' ? '快捷操作' : '显示偏好')
const reminder = ref('important')
const reminders: MoriChoiceOption[] = [{ label: '仅重要消息', value: 'important' }, { label: '全部消息', value: 'all' }, { label: '暂不提醒', value: 'none' }]
const dialogVisible = ref(false)
const noticeVisible = ref(false)
const saving = ref(false)
const saves = ref(0)
const result = ref('尚未提交')
let saveTimer: number | null = null
function notify(type: string) {
  const message = type == 'success' ? '保存成功' : type == 'error' ? '同步失败，请重试' : type == 'loading' ? '正在同步，请稍候' : '已复制到剪贴板（示例）'
  toast.value?.show({ message, type, duration: type == 'loading' ? 0 : 2000 })
}
function notifyAt(position: string) { toast.value?.show({ message: '这里是一条轻提示', position, duration: 2000 }) }
function closeToast() { toast.value?.close() }
function openPopup(position: string) { popupOverlay.value = true; popupPosition.value = position; popupVisible.value = true }
function openNonModal() { popupOverlay.value = false; popupPosition.value = 'right'; popupVisible.value = true }
function finishPopup() { popupVisible.value = false; toast.value?.show({ message: '提醒方式已更新（示例）', type: 'success' }) }
function confirmSave() {
  if (saving.value) return
  saving.value = true
  saves.value += 1
  saveTimer = setTimeout(() => {
    saveTimer = null; saving.value = false; dialogVisible.value = false
    result.value = '保存完成 · 提交 ' + saves.value + ' 次'
    toast.value?.show({ message: '保存成功', type: 'success' })
  }, 1200)
}
function cancelSave() { result.value = '已取消保存' }
function appearance(theme: string) { setMoriConfig({ theme }) }
function back() { uni.reLaunch({ url: '/pages/index/index' }) }
onUnmounted(() => { if (saveTimer != null) clearTimeout(saveTimer!) })
</script>

<style>
.feedback-scroll { flex: 1; }
.feedback-page { min-height: 100%; padding: 24px; }
.feedback-shell { width: 100%; max-width: 1080px; margin: 0 auto; }
.feedback-header { display: flex; flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 38px; }
.feedback-back { padding: 0; margin: 0; background-color: transparent; border: 0; font-size: 12px; line-height: 32px; }
.feedback-themes { display: flex; flex-direction: row; }
.feedback-intro { display: flex; flex-direction: column; margin-bottom: 26px; }
.feedback-title { font-size: 28px; line-height: 38px; font-weight: 600; }
.feedback-subtitle { font-size: 13px; line-height: 22px; margin-top: 6px; }
.feedback-content { border: 1px solid; border-radius: 12px; padding: 0 28px; }
.feedback-section { padding: 28px 0; }
.feedback-copy { max-width: 580px; }
.feedback-section-title { display: block; font-size: 15px; line-height: 24px; font-weight: 600; }
.feedback-description { display: block; font-size: 12px; line-height: 21px; margin-top: 6px; }
.feedback-actions { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 18px; }
.feedback-actions > * { margin: 0 10px 10px 0; }
.feedback-divider { height: 1px; }
.feedback-note, .feedback-result { display: block; font-size: 12px; line-height: 20px; margin-top: 6px; }
.feedback-footer { display: block; font-size: 11px; line-height: 18px; margin-top: 18px; }
.popup-example { display: flex; flex-direction: column; }
.popup-example-copy { display: block; font-size: 13px; line-height: 22px; margin-bottom: 20px; }
.popup-example-actions { display: flex; flex-direction: row; margin-top: 24px; }
/* #ifdef WEB */
.feedback-page { min-height: 100vh; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
.feedback-back::after { border: none; }
@media (max-width: 480px) { .feedback-page { padding: 16px; } .feedback-header { margin-bottom: 24px; } .feedback-title { font-size: 24px; } .feedback-content { padding: 0 18px; } }
/* #endif */
</style>
