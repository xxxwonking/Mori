<template>
  <mori-swiper v-model="current" :items="slides" />
  <mori-text :text="'第 ' + (current + 1).toString() + ' 张 / 共 3 张'" tone="muted" :size="12" />
  <mori-button label="下一张" variant="soft" @click="current = (current + 1) % 3" />
</template>
<script setup lang="uts">
import { ref } from 'vue'
import { MoriSwiperItem } from '@/uni_modules/mori-ui/content.uts'
const current = ref(0)
const slides: MoriSwiperItem[] = [{ value: 'first', src: '/static/mori-demo.svg', title: '紧凑组件' }, { value: 'second', src: '/static/mori-demo.svg', title: '系统主题' }, { value: 'third', src: '/static/mori-demo.svg', title: '自由组合' }]
</script>
