    <mori-switch :model-value="true" label="禁用状态" disabled />
    <mori-switch v-model="custom" label="自定义轨道与滑块" active-color="#4338ca" inactive-color="#c7d2fe" active-thumb-color="#ffffff" inactive-thumb-color="#312e81" active-text="开" inactive-text="关" />
    <mori-text :text="notification ? '消息通知已开启' : '消息通知已关闭'" :size="12" tone="muted" />
  </view>
</template>
